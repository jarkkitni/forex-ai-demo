# mock = รันได้เลยไม่ต้องมีคีย์ | stripe = ใช้ Stripe จริง
PAYMENT_DRIVER=mock

# ใช้เมื่อ PAYMENT_DRIVER=stripe เท่านั้น (บัญชี Stripe ต้องเป็นประเทศไทยถึงจะเปิด PromptPay ได้)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ป้องกัน endpoint reconcile ไม่ให้ถูกยิงมั่ว
CRON_SECRET=change-me

NEXT_PUBLIC_SITE_URL=http://localhost:3000
